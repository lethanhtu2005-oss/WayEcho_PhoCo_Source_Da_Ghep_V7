<!-- Inline Micro-Interactions Script for High Accessibility -->
<script>
    // State management
    let activeRole = 'hdv';
    const roleLabels = {
      'hdv': 'Hướng Dẫn Viên (Guide Pro)',
      'tnv': 'Tình Nguyện Viên Hỗ Trợ',
      'partner': 'Điểm Đến / Kinh Doanh Di Sản'
    };

    function switchRole(roleKey) {
      activeRole = roleKey;
      const tabs = document.querySelectorAll('.role-tab');
      tabs.forEach(tab => {
        tab.setAttribute('aria-selected', 'false');
        tab.classList.remove('bg-surface-pure', 'shadow-sm', 'text-on-surface');
        tab.classList.add('text-on-surface-variant');
      });

      let selectedTab;
      if (roleKey === 'hdv') selectedTab = document.getElementById('tabRole1');
      if (roleKey === 'tnv') selectedTab = document.getElementById('tabRole2');
      if (roleKey === 'partner') selectedTab = document.getElementById('tabRole3');

      if (selectedTab) {
        selectedTab.setAttribute('aria-selected', 'true');
        selectedTab.classList.remove('text-on-surface-variant');
        selectedTab.classList.add('bg-surface-pure', 'shadow-sm', 'text-on-surface');
      }

      const indicator = document.getElementById('roleSelectedIndicator');
      if (indicator) {
        indicator.textContent = 'Đang chọn: ' + roleLabels[roleKey];
      }

      // Announce for Screen Readers via synthetic live region
      speakText('Bạn đã chuyển sang vai trò: ' + roleLabels[roleKey]);
    }

    function togglePasswordVisibility() {
      const pwInput = document.getElementById('passwordInput');
      const toggleIcon = document.getElementById('togglePasswordIcon');
      const toggleBtn = document.getElementById('togglePasswordBtn');

      if (pwInput.type === 'password') {
        pwInput.type = 'text';
        toggleIcon.textContent = 'visibility_off';
        toggleBtn.setAttribute('aria-label', 'Ẩn mật khẩu');
        speakText('Mật khẩu đang hiển thị dạng văn bản');
      } else {
        pwInput.type = 'password';
        toggleIcon.textContent = 'visibility';
        toggleBtn.setAttribute('aria-label', 'Hiển thị mật khẩu dưới dạng văn bản');
        speakText('Mật khẩu đã được ẩn');
      }
    }

    function playAudioCue(field) {
      if (field === 'identity') {
        speakText('Ô nhập tên đăng nhập, email đối tác hoặc mã định danh cấp bởi Ban quản lý Phố Cổ.');
      }
    }

    function speakText(msg) {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(msg);
        utterance.lang = 'vi-VN';
        utterance.rate = 1.0;
        window.speechSynthesis.speak(utterance);
      }
    }

    // Voice guidance button
    const btnVoice = document.getElementById('btnVoiceGuide');
    if (btnVoice) {
      btnVoice.addEventListener('click', function() {
        speakText('Chào mừng bạn đến Cổng Đối tác WayEcho Phố Cổ Hà Nội. Nhấn Alt cộng L để nhập tên đăng nhập. Nhấn Alt cộng R để thay đổi vai trò giữa Hướng Dẫn Viên, Tình Nguyện Viên và Điểm Đến.');
      });
    }

    // Hotkey listener for Accessible Navigation
    window.addEventListener('keydown', function(e) {
      if (e.altKey && (e.key === 'l' || e.key === 'L')) {
        e.preventDefault();
        const input = document.getElementById('identityInput');
        if (input) input.focus();
      } else if (e.altKey && (e.key === 'r' || e.key === 'R')) {
        e.preventDefault();
        if (activeRole === 'hdv') switchRole('tnv');
        else if (activeRole === 'tnv') switchRole('partner');
        else switchRole('hdv');
      }
    });

    // Form submit feedback
    function triggerAuthSim() {
      const submitBtn = document.getElementById('btnSubmitLogin');
      const originalText = submitBtn.innerHTML;
      submitBtn.disabled = true;
      submitBtn.innerHTML = '<span class="material-symbols-outlined animate-spin text-[24px]">progress_activity</span><span>Đang đồng bộ hóa khóa bảo mật...</span>';
      
      speakText('Hệ thống đang xác thực dữ liệu đối tác...');

      setTimeout(function() {
        submitBtn.disabled = false;
        submitBtn.innerHTML = originalText;
        alert('Đăng nhập thành công vào Bảng Điều Phối WayEcho (Môi trường Thử nghiệm An toàn).');
      }, 1200);
    }
