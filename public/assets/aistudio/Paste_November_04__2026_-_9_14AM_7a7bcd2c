<!-- INLINE CLIENT SCRIPT FOR ACCESSIBILITY TTS & INTERACTIONS -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
      const ttsBtn = document.getElementById('tts-intro-btn');
      let isSpeaking = false;

      if (ttsBtn && 'speechSynthesis' in window) {
        ttsBtn.addEventListener('click', () => {
          if (isSpeaking) {
            window.speechSynthesis.cancel();
            isSpeaking = false;
            ttsBtn.querySelector('span:last-child').textContent = 'Nghe giới thiệu âm thanh (TTS)';
            ttsBtn.classList.remove('bg-error', 'text-on-error');
            ttsBtn.classList.add('bg-primary-container', 'text-on-primary-container');
          } else {
            const textToSpeak = "Chào mừng quý khách đến với trang Tour và Trải nghiệm đa giác quan của WayEcho Hà Nội. Khám phá 36 phố phường không rào cản qua hệ thống âm thanh 3D Binaural, xúc giác chạm vào di sản gạch nung Bát Tràng và người đồng hành tận tâm chuẩn WBU. Quý khách có thể lựa chọn 4 hành trình nổi bật hoặc liên hệ hotline khẩn cấp 1900 8282 nhánh 1.";
            const utterance = new SpeechSynthesisUtterance(textToSpeak);
            utterance.lang = 'vi-VN';
            utterance.rate = 0.95;

            utterance.onend = () => {
              isSpeaking = false;
              ttsBtn.querySelector('span:last-child').textContent = 'Nghe giới thiệu âm thanh (TTS)';
              ttsBtn.classList.remove('bg-error', 'text-on-error');
              ttsBtn.classList.add('bg-primary-container', 'text-on-primary-container');
            };

            window.speechSynthesis.speak(utterance);
            isSpeaking = true;
            ttsBtn.querySelector('span:last-child').textContent = 'Dừng phát giọng nói';
            ttsBtn.classList.remove('bg-primary-container', 'text-on-primary-container');
            ttsBtn.classList.add('bg-error', 'text-on-error');
          }
        });
      }
    });
  </script>
