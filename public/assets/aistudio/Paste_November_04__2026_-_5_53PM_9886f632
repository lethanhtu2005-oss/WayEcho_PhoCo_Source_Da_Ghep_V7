<script>
    function toggleOfflineModal() {
      const modal = document.getElementById('offline-modal');
      if (modal.open) {
        modal.close();
      } else {
        modal.showModal();
      }
    }

    function simulateDownload(btn) {
      btn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">progress_activity</span> Đang chuẩn bị tệp âm thanh...';
      btn.disabled = true;
      setTimeout(() => {
        btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check</span> Tải thành công!';
        setTimeout(() => {
          toggleOfflineModal();
          btn.innerHTML = '<span class="material-symbols-outlined text-[18px]">save_alt</span> Bắt đầu tải gói (48.2 MB)';
          btn.disabled = false;
        }, 1200);
      }, 1500);
