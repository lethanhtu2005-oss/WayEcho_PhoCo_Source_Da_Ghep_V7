<script>
    // Keyboard Shortcut Accessibility Handlers
    document.addEventListener('keydown', function(e) {
      if (e.altKey && (e.key === 'r' || e.key === 'R')) {
        e.preventDefault();
        document.getElementById('tts-read-all').click();
      }
      if (e.altKey && (e.key === 'm' || e.key === 'M')) {
        e.preventDefault();
        document.getElementById('mark-all-read').click();
      }
      if (e.altKey && (e.key === 'f' || e.key === 'F')) {
        e.preventDefault();
        const firstTab = document.querySelector('[role="tab"]');
        if (firstTab) firstTab.focus();
      }
    });

    // Mock Web Speech TTS Engine with Visual Toast
    function playMockTTS(text) {
      const toast = document.getElementById('tts-feedback-toast');
      const toastText = document.getElementById('tts-toast-text');
      toastText.innerText = text;
      
      toast.classList.remove('translate-y-32', 'opacity-0', 'pointer-events-none');
      
      // Native SpeechSynthesis fallback
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
        const utterance = new SpeechSynthesisUtterance(text);
        utterance.lang = 'vi-VN';
        utterance.rate = 1.0;
        window.speechSynthesis.speak(utterance);
      }

      setTimeout(() => {
        toast.classList.add('translate-y-32', 'opacity-0', 'pointer-events-none');
      }, 4500);
    }

    // Mock Haptic Wand vibration
    function testHapticVibrate() {
      if (navigator.vibrate) {
        navigator.vibrate([200, 100, 200]);
      }
      playMockTTS('Đã gửi tín hiệu rung kép đến gậy thông minh WayEcho. Kết nối Bluetooth hoạt động tốt.');
