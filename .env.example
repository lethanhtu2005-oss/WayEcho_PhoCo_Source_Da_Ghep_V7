# WayEcho chạy tự động không cần biến môi trường trong chế độ Preview/Dev.
# Các biến dưới đây chỉ dùng khi triển khai Production (tùy chọn):
# NEXT_PUBLIC_SITE_URL=https://wayecho.vn
# OPENAI_API_KEY=
# WAYECHO_DATA_PATH=
# WAYECHO_INQUIRIES_ENABLED=1
# WAYECHO_ORIGIN=
# WAYECHO_PROXY_SECRET=
# WAYECHO_SESSION_SECRET=
# WAYECHO_STORAGE_MODE=
# WAYECHO_TRUSTED_IP_HEADER=
# WAYECHO_USERS=
# WAYECHO_VISION_MODEL=gpt-4.1-mini