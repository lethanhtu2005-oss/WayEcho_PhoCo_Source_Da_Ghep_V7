# WayEcho Environment Configuration Example

# Optional Gemini API key for AI assistant multimodal visual scene description
GEMINI_API_KEY=

# Optional OpenAI API key (alternative fallback for assistant vision)
OPENAI_API_KEY=
WAYECHO_VISION_MODEL=gpt-4.1-mini

# Session secret (required in production, >= 32 chars)
WAYECHO_SESSION_SECRET=development-session-secret-must-be-32-chars-long

# Provisioned users JSON for production/serverless environment
# WAYECHO_USERS=

# Storage mode: 'memory' or 'local-single-host' (defaults to file locally, memory on Vercel)
# WAYECHO_STORAGE_MODE=local-single-host
# WAYECHO_DATA_PATH=data/db.json

# Origin allowed for write requests
# WAYECHO_ORIGIN=http://localhost:3000

# Canonical site URL for SEO / sitemap
# NEXT_PUBLIC_SITE_URL=https://wayecho.example.com

# Enable collaboration inquiries
# WAYECHO_INQUIRIES_ENABLED=1

# Demo controls
WAYECHO_DEMO_LOGIN=1
WAYECHO_DEMO_VIDEO_ENABLED=true
